{
  "metadata": [
    {
      // The C# API needs no custom tooling: DocFX reads the built assembly together with the
      // XML documentation file the engine build already emits next to it. Reading the assembly
      // rather than Apogee.CSharp.csproj is deliberate — that project file is generated by
      // Apogee.Build and lists ~1500 sources with engine-specific MSBuild targets, which Roslyn
      // cannot load standalone.
      "src": [
        {
          "files": [ "Binaries/Editor/*/Development/Apogee.CSharp.dll" ],
          "src": "Apogee.Engine"
        }
      ],
      "dest": "api",
      "filter": "api-filter.yml",
      "outputFormat": "mref",
      "allowCompilationErrors": true
    }
  ],

  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md",
          "api-cpp/**.yml",
          "api-cpp/index.md",
          "api-lua/**.yml",
          "api-lua/index.md"
        ]
      },
      {
        "files": [
          "manual/**/*.md",
          "manual/**/toc.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**",
          "Apogee.Engine/**",
          "tools/**",
          "README.md",
          "LICENSE.md",
          "CONTRIBUTING.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "media/**",
          "favicon.ico",
          "logo.png"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern", "template" ],
    "globalMetadata": {
      "_appTitle": "Apogee Engine Documentation",
      "_appName": "Apogee",
      "_appFooter": "Copyright © 2024-2026 Apogee Engine. Documentation licensed under <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a>.",
      "_appLogoPath": "logo.png",
      "_appFaviconPath": "favicon.ico",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/lheintzmann1/Apogee.Docs",
        "branch": "main"
      },
      "_gitUrlPattern": "github"
    },
    "sitemap": {
      "baseUrl": "https://lheintzmann1.github.io/Apogee.Docs/",
      "changefreq": "weekly"
    },
    "xref": [],
    "xrefService": [],
    "postProcessors": [ "ExtractSearchIndex" ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
